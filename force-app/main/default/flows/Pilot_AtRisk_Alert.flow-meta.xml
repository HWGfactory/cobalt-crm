        <defaultConnectorLabel>No Action</defaultConnectorLabel>
        <rules>
            <name>Newly_AtRisk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Pilot_Health__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>At Risk</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Notification_Type</targetReference>
            </connector>
            <label>Newly At Risk</label>
        </rules>
