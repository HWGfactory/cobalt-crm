        <inputAssignments>
            <field>Renewal_Opportunity__c</field>
            <value>
                <elementReference>NewOpportunityId</elementReference>
            </value>
        </inputAssignments>
        <object>Contract</object>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <start>
