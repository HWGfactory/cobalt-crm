<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Renewal_Window</name>
        <label>Check Renewal Window</label>
        <locationX>176</locationX>
        <locationY>140</locationY>
        <defaultConnectorLabel>Not In Window</defaultConnectorLabel>
        <rules>
            <name>Is_90_Days_Out</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Target90Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task_90</targetReference>
            </connector>
            <label>Is 90 Days Out</label>
        </rules>
        <rules>
            <name>Is_60_Days_Out</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Target60Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task_60</targetReference>
            </connector>
            <label>Is 60 Days Out</label>
        </rules>
        <rules>
            <name>Is_30_Days_Out</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Target30Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task_30</targetReference>
            </connector>
            <label>Is 30 Days Out</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Renewal_Opp_Exists</name>
        <label>Check Renewal Opp Exists</label>
        <locationX>176</locationX>
        <locationY>380</locationY>
        <defaultConnectorLabel>Already Exists</defaultConnectorLabel>
        <rules>
            <name>No_Renewal_Opp_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Renewal_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Renewal_Opportunity</targetReference>
            </connector>
            <label>No Renewal Opp Yet</label>
        </rules>
    </decisions>
    <formulas>
        <name>Target90Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <formulas>
        <name>Target60Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 60</expression>
    </formulas>
    <formulas>
        <name>Target30Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>EndDateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.EndDate})</expression>
    </formulas>
    <formulas>
        <name>TaskSubject90</name>
        <dataType>String</dataType>
        <expression>&quot;[갱신 알림 D-90] &quot; &amp; {!$Record.Account.Name} &amp; &quot; 계약 만료 임박&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskSubject60</name>
        <dataType>String</dataType>
        <expression>&quot;[갱신 알림 D-60] &quot; &amp; {!$Record.Account.Name} &amp; &quot; 계약 만료 임박&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskSubject30</name>
        <dataType>String</dataType>
        <expression>&quot;[갱신 알림 D-30] &quot; &amp; {!$Record.Account.Name} &amp; &quot; 계약 만료 임박&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskDescription90</name>
        <dataType>String</dataType>
        <expression>&quot;계약(&quot; &amp; {!$Record.ContractNumber} &amp; &quot;)이 90일 후(&quot; &amp; {!EndDateText} &amp; &quot;) 만료됩니다. 갱신 Opportunity가 자동 생성되었습니다. 갱신 논의를 시작하세요.&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskDescription60</name>
        <dataType>String</dataType>
        <expression>&quot;계약(&quot; &amp; {!$Record.ContractNumber} &amp; &quot;)이 60일 후(&quot; &amp; {!EndDateText} &amp; &quot;) 만료됩니다. 갱신 Opportunity 진행 상황을 점검하세요.&quot;</expression>
    </formulas>
    <formulas>
        <name>TaskDescription30</name>
        <dataType>String</dataType>
        <expression>&quot;계약(&quot; &amp; {!$Record.ContractNumber} &amp; &quot;)이 30일 후(&quot; &amp; {!EndDateText} &amp; &quot;) 만료됩니다. 갱신 계약 서명을 서둘러 진행하세요.&quot;</expression>
    </formulas>
    <formulas>
        <name>RenewalOppName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account.Name} &amp; &quot; - Renewal&quot;</expression>
    </formulas>
    <interviewLabel>Contract Renewal Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Renewal Reminder</label>
    <processType>AutoLaunchedFlow</processType>
